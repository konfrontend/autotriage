{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/profile/skills.md frontmatter: the Skill ledger (ADR 0003, catalogue/skills.md). One row per Skill; Targets are derived from level and seen, never stored.",
  "type": "object",
  "required": ["target_after", "skills"],
  "additionalProperties": false,
  "properties": {
    "target_after": { "type": "integer", "minimum": 1, "default": 3 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "contains": { "properties": { "level": { "const": "shipped" } }, "required": ["level"] },
      "items": {
        "type": "object",
        "required": ["name", "category", "level", "evidence", "keywords", "seen"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["frontend", "backend", "database", "cloud-infra", "testing", "graphics-3d", "ai-agents", "mobile", "other"] },
          "level": { "enum": ["gap", "learning", "used", "shipped"] },
          "evidence": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
          "keywords": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^[^A-Z\\s][^A-Z]*$" }, "uniqueItems": true },
          "seen": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" }, "uniqueItems": true }
        },
        "if": { "properties": { "level": { "enum": ["used", "shipped"] } } },
        "then": { "properties": { "evidence": { "minItems": 1 } } }
      }
    }
  }
}
